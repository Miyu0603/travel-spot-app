# Copy this file to .env and fill in your API keys
# Every key here must also be declared in app/config.py — pydantic-settings
# rejects unknown keys and the backend then refuses to start.

# Apify (for IG/FB scraping)
APIFY_API_TOKEN=

# OpenAI (for LLM extraction & Whisper transcription)
OPENAI_API_KEY=

# Google Maps / Places API
GOOGLE_MAPS_API_KEY=

# Database (default: SQLite; production uses the Supabase session pooler URL)
DATABASE_URL=sqlite:///./travel_spots.db

# Shared password the frontend sends as X-API-Key. Empty disables auth (local dev).
API_SECRET=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Caps on the AI extraction endpoints (0 disables a limit)
RATE_LIMIT_PER_IP_HOURLY=10
RATE_LIMIT_GLOBAL_DAILY=50
